# ==== Database (PostgreSQL) ====
# Pakai Supabase/Neon/Railway untuk produksi. Untuk dev lokal, ganti dengan koneksi lokal.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/milad290?schema=public"

# ==== Auth (NextAuth) ====
# Generate dengan: openssl rand -base64 32
AUTH_SECRET="GANTI_DENGAN_STRING_ACAK_PANJANG"

# ==== URL aplikasi ====
NEXTAUTH_URL="http://localhost:3000"

# ==== Admin default (dibuat saat seed) ====
ADMIN_EMAIL="admin@miladsidogiri.id"
ADMIN_PASSWORD="GantiPasswordAdmin123!"
ADMIN_NAMA="Administrator"

# ==== Upload berkas ====
STORAGE_PROVIDER="local" # local | vercel-blob | r2

# --- vercel-blob ---
BLOB_READ_WRITE_TOKEN=""

# --- r2 (Cloudflare R2, S3-compatible) ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""

# Storage folder untuk mode local (folder tersembunyi di dalam project, bukan /public)
LOCAL_STORAGE_DIR="./storage/uploads"

# ==== Notifikasi email (opsional, SMTP — mis. Mailspace DomaiNesia) ====
# Kosongkan bila belum ingin mengirim email. Tanpa ini pendaftaran tetap berjalan.
# Kredensial diambil dari panel Mailspace DomaiNesia: nama host mail server
# (bukan selalu "mail.domainanda.com" — cek di panel Mailspace, mis.
# leona.rapidplex.com), port 465 (SSL) atau 587 (STARTTLS), dan alamat email
# beserta password mailbox-nya sebagai username/password.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Lomba Milad 290 <noreply@miladsidogiri.id>"
