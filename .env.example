# ==== Database (PostgreSQL) ====
# Pakai Supabase/Neon/Railway untuk produksi. Untuk dev lokal, ganti dengan koneksi lokal.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/milad290?schema=public"

# ==== Auth (NextAuth) ====
# Generate dengan: openssl rand -base64 32
AUTH_SECRET="GANTI_DENGAN_STRING_ACAK_PANJANG"

# ==== URL aplikasi ====
NEXTAUTH_URL="http://localhost:3000"

# ==== Admin default (dibuat saat seed) ====
ADMIN_EMAIL="admin@miladsidogiri.id"
ADMIN_PASSWORD="GantiPasswordAdmin123!"
ADMIN_NAMA="Administrator"

# ==== Upload berkas (Vercel Blob / Supabase Storage) ====
BLOB_READ_WRITE_TOKEN=""
STORAGE_PROVIDER="local" # local | vercel-blob | supabase

# Storage folder untuk mode local (folder tersembunyi di dalam project, bukan /public)
LOCAL_STORAGE_DIR="./storage/uploads"

# ==== Notifikasi email (opsional, Resend) ====
# Kosongkan bila belum ingin mengirim email. Tanpa ini pendaftaran tetap berjalan.
RESEND_API_KEY=""
RESEND_FROM="Lomba Milad 290 <onboarding@resend.dev>"
